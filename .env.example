# HandoffHub Backend - Environment Variables

# Local development (MySQL-style, for reference only)
# DB_URL=jdbc:mysql://localhost:3306/handoffhub?createDatabaseIfNotExist=true
# DB_USERNAME=root
# DB_PASSWORD=password

# Production (Render PostgreSQL)
# Render automatically sets DATABASE_URL when you link a PostgreSQL database.
# Copy the Internal Database URL from Render dashboard and set it here for local testing:
DATABASE_URL=jdbc:postgresql://localhost:5432/handoffhub

# Server port (Render sets PORT automatically)
PORT=8080
